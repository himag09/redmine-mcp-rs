# Redmine MCP server configuration.
# Copy this file to `.env` and fill in the required values.
# Process environment variables (the MCP client `env` block) always win over
# this file; `.env` only fills variables that are not already set.

# Required
REDMINE_URL=https://redmine.example.com/
REDMINE_API_KEY=your-redmine-api-key

# Optional
# Project used by create_issue when project_id is omitted.
# REDMINE_DEFAULT_PROJECT_ID=1

# HTTP timeout in milliseconds (1000-300000, default 30000).
# REDMINE_TIMEOUT_MS=30000

# Set to true to hide and reject every write tool (recommended for production).
# REDMINE_READ_ONLY=false

# stderr log level: off, error, warn, info or debug (default error).
# REDMINE_LOG=error
